<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Clamshell</title>
    <options customize="never" require-scripts="true" hostArchitectures="arm64"/>
    <allowed-os-versions>
        <os-version min="13.0"/>
    </allowed-os-versions>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <choices-outline>
        <line choice="clamshell"/>
    </choices-outline>
    <choice id="clamshell" visible="false" title="Clamshell">
        <pkg-ref id="local.clamshell.pkg"/>
    </choice>
    <pkg-ref id="local.clamshell.pkg">clamshell-component.pkg</pkg-ref>
</installer-gui-script>
