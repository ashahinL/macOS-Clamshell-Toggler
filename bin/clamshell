#!/bin/bash
#
# clamshell — use your Mac with the lid closed, on battery power.
#
# macOS only supports closed-display ("clamshell") mode while on AC power.
# This flips pmset's undocumented `disablesleep` flag, but only while an
# external display is actually attached — so a lid closed in a bag still
# sleeps normally instead of cooking.
#
# https://github.com/ashahinL/macos-clamshell
# SPDX-License-Identifier: MIT

set -uo pipefail

readonly VERSION='1.0.0'
readonly LABEL='local.clamshell'
readonly LOG_FILE='/var/log/clamshell.log'
readonly POLL_INTERVAL=10

# ------------------------------------------------------------------ output ---

if [[ -t 1 ]]; then
	C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
	C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'
else
	C_RESET=''; C_BOLD=''; C_DIM=''
	C_GREEN=''; C_YELLOW=''; C_RED=''
fi
readonly C_RESET C_BOLD C_DIM C_GREEN C_YELLOW C_RED

die() { printf '%sclamshell: %s%s\n' "$C_RED" "$*" "$C_RESET" >&2; exit 1; }

# ------------------------------------------------------------------- config ---

# The watcher runs as root, where $HOME is /var/root — so the installer bakes
# the real user's path into the LaunchDaemon argv. Interactive use resolves it
# from the environment instead.
if [[ -n "${CLAMSHELL_MODE_FILE:-}" ]]; then
	MODE_FILE="$CLAMSHELL_MODE_FILE"
else
	MODE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/clamshell/mode"
fi

# ------------------------------------------------------------------ probes ---

# Count attached external displays.
#
# Nodes carrying `SinkDeviceOUI` exist only for a physically connected external
# sink (the OUI is read out of the monitor's EDID over DP/HDMI). The built-in
# panel never publishes this key, so this cleanly separates internal from
# external without needing a GUI session — which matters because the watcher
# runs from a LaunchDaemon with no window server access.
external_displays() {
	ioreg -r -k SinkDeviceOUI -d1 -w0 2>/dev/null |
		awk '/^\+-o /{n++} END{print n+0}'
}

lid_is_closed() {
	ioreg -r -k AppleClamshellState -d4 2>/dev/null |
		awk '/"AppleClamshellState" = Yes/{f=1} END{exit !f}'
}

power_source() {
	pmset -g batt 2>/dev/null | sed -n "1s/Now drawing from //p" | tr -d "'"
}

sleep_disabled() {
	pmset -g 2>/dev/null | awk '/SleepDisabled/{print $2}'
}

watcher_pid() {
	pgrep -f "clamshell --watch" 2>/dev/null | head -1
}

# -------------------------------------------------------------------- mode ---

read_mode() {
	local m=''
	[[ -r "$MODE_FILE" ]] && m=$(tr -d '[:space:]' < "$MODE_FILE" 2>/dev/null)
	case "$m" in
		on|off|auto) printf '%s' "$m" ;;
		*)           printf 'auto' ;;
	esac
}

write_mode() {
	local mode="$1" dir
	dir="$(dirname "$MODE_FILE")"
	mkdir -p "$dir" 2>/dev/null || die "cannot create $dir"
	printf '%s\n' "$mode" > "$MODE_FILE" 2>/dev/null ||
		die "cannot write $MODE_FILE"

	printf '%smode → %s%s%s\n' "$C_DIM" "$C_BOLD" "$mode" "$C_RESET"
	case "$mode" in
		auto) printf 'Stays awake with the lid closed only while an external display is attached.\n' ;;
		on)   printf '%sStays awake with the lid closed even with no display attached.%s\n' "$C_YELLOW" "$C_RESET"
		      printf 'Remember to switch back to %sclamshell auto%s before travelling.\n' "$C_BOLD" "$C_RESET" ;;
		off)  printf 'Normal macOS behaviour: closing the lid always sleeps.\n' ;;
	esac
	if [[ -n "$(watcher_pid)" ]]; then
		printf '%sApplies within %ss.%s\n' "$C_DIM" "$POLL_INTERVAL" "$C_RESET"
	else
		printf '%sWatcher is not running — run: sudo clamshell-install%s\n' \
			"$C_YELLOW" "$C_RESET"
	fi
}

# Resolve the mode to the SleepDisabled value it wants.
# `auto` fails safe: anything unexpected means "let the machine sleep".
want_value() {
	case "$(read_mode)" in
		on)  printf 1 ;;
		off) printf 0 ;;
		*)
			local n
			n=$(external_displays)
			if [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 )); then printf 1; else printf 0; fi
			;;
	esac
}

# ----------------------------------------------------------------- commands ---

cmd_watch() {
	[[ $EUID -eq 0 ]] || die "--watch must run as root (it is started by launchd)"

	local prev='' want
	while :; do
		want=$(want_value)
		if [[ "$want" != "$prev" ]]; then
			if pmset -b disablesleep "$want" 2>>"$LOG_FILE"; then
				printf '%s mode=%s displays=%s disablesleep=%s\n' \
					"$(date '+%Y-%m-%d %H:%M:%S')" "$(read_mode)" \
					"$(external_displays)" "$want" >> "$LOG_FILE"
				prev="$want"
			fi
		fi
		sleep "$POLL_INTERVAL"
	done
}

cmd_status() {
	local mode displays lid pid awake
	mode=$(read_mode)
	displays=$(external_displays)
	lid=open
	lid_is_closed && lid=closed
	pid=$(watcher_pid)
	awake=$(sleep_disabled)

	printf '%sclamshell %s%s\n\n' "$C_BOLD" "$VERSION" "$C_RESET"
	printf '  mode                %s%s%s\n' "$C_BOLD" "$mode" "$C_RESET"
	printf '  external displays   %s\n' "$displays"
	printf '  lid                 %s\n' "$lid"
	printf '  power               %s\n' "$(power_source)"
	printf '  sleep disabled      %s\n' "${awake:-unknown}"
	if [[ -n "$pid" ]]; then
		printf '  watcher             %srunning%s (pid %s)\n' "$C_GREEN" "$C_RESET" "$pid"
	else
		printf '  watcher             %snot running%s\n' "$C_RED" "$C_RESET"
	fi
	printf '  mode file           %s\n\n' "$MODE_FILE"

	if [[ "$awake" == '1' ]]; then
		printf '%s→ Closing the lid keeps this Mac awake.%s\n' "$C_GREEN" "$C_RESET"
	else
		printf '%s→ Closing the lid will send this Mac to sleep.%s\n' "$C_DIM" "$C_RESET"
	fi
}

# Machine-readable status, for the menu bar app and for scripting.
cmd_json() {
	local pid awake
	local lid_closed=false on_battery=false sleep_off=false watching=false

	pid=$(watcher_pid)
	awake=$(sleep_disabled)

	lid_is_closed && lid_closed=true
	[[ "$(power_source)" == 'Battery Power' ]] && on_battery=true
	[[ "$awake" == '1' ]] && sleep_off=true
	[[ -n "$pid" ]] && watching=true

	printf '{'
	printf '"version":"%s",'      "$VERSION"
	printf '"mode":"%s",'         "$(read_mode)"
	printf '"displays":%s,'       "$(external_displays)"
	printf '"lidClosed":%s,'      "$lid_closed"
	printf '"onBattery":%s,'      "$on_battery"
	printf '"sleepDisabled":%s,'  "$sleep_off"
	printf '"watcherRunning":%s,' "$watching"
	printf '"modeFile":"%s"'      "$MODE_FILE"
	printf '}\n'
}

cmd_log() {
	[[ -r "$LOG_FILE" ]] || die "no log at $LOG_FILE"
	tail -n "${1:-20}" "$LOG_FILE"
}

cmd_help() {
	cat <<HELP
${C_BOLD}clamshell${C_RESET} ${VERSION} — use your Mac with the lid closed, on battery.

${C_BOLD}USAGE${C_RESET}
  clamshell [command]

${C_BOLD}COMMANDS${C_RESET}
  status         Show what is happening right now (default)
  auto           Stay awake with the lid closed only while an
                 external display is attached  ${C_DIM}(recommended)${C_RESET}
  on             Stay awake with the lid closed, display or not
  off            Normal macOS behaviour — closing the lid sleeps
  log [n]        Show the last n state changes (default 20)
  help           Show this message
  version        Show the version

${C_BOLD}NOTES${C_RESET}
  Switching modes never needs sudo. The change is picked up by the
  background watcher within ${POLL_INTERVAL} seconds.

  ${C_YELLOW}on${C_RESET} keeps the machine awake with no display attached, which
  will drain the battery and heat the Mac in a closed bag. Prefer
  ${C_BOLD}auto${C_RESET} unless you specifically need a headless session.

${C_BOLD}HOMEPAGE${C_RESET}
  https://github.com/ashahinL/macos-clamshell
HELP
}

# --------------------------------------------------------------------- main ---

case "${1:-status}" in
	status)          cmd_status ;;
	json|--json)     cmd_json ;;
	auto|on|off)     write_mode "$1" ;;
	log)             cmd_log "${2:-20}" ;;
	help|-h|--help)  cmd_help ;;
	version|--version) printf '%s\n' "$VERSION" ;;
	--want)          want_value; printf '\n' ;;   # internal: used by tests
	--watch)
		[[ $# -ge 2 ]] && MODE_FILE="$2"
		cmd_watch
		;;
	*)
		printf 'clamshell: unknown command %s\n\n' "$1" >&2
		cmd_help >&2
		exit 64
		;;
esac
